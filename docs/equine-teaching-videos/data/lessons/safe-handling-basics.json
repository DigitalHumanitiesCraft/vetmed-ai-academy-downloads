      "id": "lead",
      "label": "Links auf Schulterhöhe neben dem Pferd führen",
      "why": "Von dort bemerkt die Person früh, wenn das Pferd ausweicht, und geht nicht vor ihm.",
      "passages": [
        {"source": "ext", "locator": "Leading the Horse"},
        {"source": "psu", "locator": "Where to Stand"},
